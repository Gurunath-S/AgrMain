{
  "name": "agr-jewellery-desktop",
  "version": "1.0.5",
  "description": "AGR Jewellery Management Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -k \"npm --prefix server run dev\" \"npm --prefix client run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:client": "npm --prefix client run build",
    "dist": "npm run build:client && electron-builder",
    "dist:win": "npm run build:client && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "build": {
    "appId": "com.agr.jewellery.desktop",
    "productName": "AGR Jewellery Management",
    "icon": "client/public/app-logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "extraFiles": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/*.log",
          "!backup.sql",
          "!out.txt",
          "!err.txt",
          "!output.txt"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "client/public/app-logo.png",
      "category": "Office",
      "maintainer": "AGR Tech <support@agr.com>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "client/public/app-logo.ico",
      "asar": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "client/public/app-logo.ico",
      "uninstallerIcon": "client/public/app-logo.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Gurunath-S",
      "repo": "AgrMain"
    }
  },
  "keywords": [
    "electron",
    "jewellery",
    "management",
    "agr"
  ],
  "author": "AGR Tech <support@agr.com>",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  }
}
